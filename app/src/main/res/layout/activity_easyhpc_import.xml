<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="同步超算习堂"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEasyHpcUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="账号"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurface" />

    <EditText
        android:id="@+id/etEasyHpcPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="密码"
        android:inputType="textPassword"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurface" />

    <Button
        android:id="@+id/btnSyncEasyHpc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@android:color/darker_gray"
        android:text="抓取作业"
        android:textColor="?attr/colorSurface" />

    <TextView
        android:id="@+id/tvEasyHpcStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="等待抓取"
        android:textColor="?attr/colorOnSurface" />

    <ScrollView
        android:id="@+id/svEasyHpcPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llEasyHpcSources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnImportEasyHpc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@android:color/darker_gray"
        android:text="导入已选作业"
        android:textColor="?attr/colorSurface"
        android:visibility="gone" />
</LinearLayout>
